# ─────────────────────────────────────────────────────────────────────────────
# .env.example — Intelligent Email Assistant
#
# Copy this file to .env and fill in your real values.
# NEVER commit .env to version control.
#
# Generate JWT_SECRET:
#   node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
#
# Generate TOKEN_ENCRYPTION_KEY:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# ─────────────────────────────────────────────────────────────────────────────


# ── Application ──────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=5000

# ── MongoDB ──────────────────────────────────────────────────────────────────
# Local:   mongodb://localhost:27017/email-assistant
# Atlas:   mongodb+srv://<user>:<pass>@cluster.mongodb.net/email-assistant
MONGODB_URI=mongodb://localhost:27017/email-assistant

# ── JWT (auth cookies) ────────────────────────────────────────────────────────
# Must be at least 64 hex characters (256 bits).
JWT_SECRET=REPLACE_WITH_GENERATED_SECRET

# ── CORS — Frontend origin ───────────────────────────────────────────────────
CLIENT_URL=http://localhost:3000

# ── Gmail OAuth 2.0 ──────────────────────────────────────────────────────────
# Create credentials at: https://console.cloud.google.com/apis/credentials
# Set redirect URI to:   http://localhost:5000/api/gmail/oauth/callback
GOOGLE_CLIENT_ID=REPLACE_WITH_GOOGLE_CLIENT_ID
GOOGLE_CLIENT_SECRET=REPLACE_WITH_GOOGLE_CLIENT_SECRET
GOOGLE_REDIRECT_URI=http://localhost:5000/api/gmail/oauth/callback
GOOGLE_OAUTH_SCOPES=https://www.googleapis.com/auth/gmail.readonly https://www.googleapis.com/auth/gmail.send https://www.googleapis.com/auth/gmail.modify

# ── Token Encryption ─────────────────────────────────────────────────────────
# AES-256-GCM key for encrypting Gmail OAuth tokens at rest.
# Must be exactly 64 hex characters (32 bytes).
TOKEN_ENCRYPTION_KEY=REPLACE_WITH_64_CHAR_HEX_KEY

# ── AI Providers (optional — app works without AI features) ──────────────────
# OpenRouter (primary): https://openrouter.ai
OPENROUTER_API_KEY=REPLACE_WITH_OPENROUTER_KEY

# Google Gemini (fallback): https://aistudio.google.com
GEMINI_API_KEY=REPLACE_WITH_GEMINI_KEY
